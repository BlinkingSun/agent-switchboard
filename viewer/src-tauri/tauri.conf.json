{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Switchboard",
  "version": "1.4.1",
  "identifier": "com.agent-switchboard",
  "build": {
    "frontendDist": "../dist/switchboard-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Switchboard",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#0b0e12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.halus.ai; frame-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}