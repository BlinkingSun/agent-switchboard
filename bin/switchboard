def name_ok(name):
    return bool(name) and all(c.isalnum() or c in "-_." for c in name) and name not in (".", "..")


def iso(t=None):
    return datetime.datetime.fromtimestamp(t if t is not None else time.time()).strftime(
        "%Y-%m-%dT%H:%M:%S"
    )


def task_dir(task):
    return os.path.join(ROOT, task)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


# ---------------------------------------------------------------- process probe

if os.name == "nt":
    import ctypes

    def pid_alive(pid):
        # NEVER use os.kill(pid, 0) on Windows — any sig other than the two
        # CTRL events unconditionally TerminateProcess()es the target.
        if not pid:
            return False
        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        STILL_ACTIVE = 259
        ERROR_ACCESS_DENIED = 5
        k32 = ctypes.windll.kernel32
        h = k32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, int(pid))
        if not h:
            # query failure != death; only a definitive lookup miss is dead
            return ctypes.get_last_error() == ERROR_ACCESS_DENIED or \
                k32.GetLastError() == ERROR_ACCESS_DENIED
        try:
            code = ctypes.c_ulong()
            if not k32.GetExitCodeProcess(h, ctypes.byref(code)):
                return True  # fail-open
            return code.value == STILL_ACTIVE
        finally:
            k32.CloseHandle(h)
else:

    def pid_alive(pid):
        if not pid:
            return False
        try:
            os.kill(int(pid), 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        except Exception:
            return False


# ---------------------------------------------------------------- CLI detect + forest
# CLI forest: classify from argv0/path only; collapse shims; reattach to keep-nodes.

PS_CLI_CMD = ["ps", "-axo", "pid=,ppid=,tty=,lstart=,command="]
# lstart is exactly 5 whitespace-separated tokens: Mon Aug  9 22:09:11 2026
_PS_CLI_LINE = re.compile(
    r"^\s*(\d+)\s+(\d+)\s+(\S+)\s+"
    r"(\w{3}\s+\w{3}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\d{4})\s+(.*)$"
)
_PYTHON_NAMES = {
    "Python",
    "Python3",
    "python",
    "python3",
    "python3.9",
    "python3.10",
    "python3.11",
    "python3.12",
    "python3.13",
    "python3.14",
}
_SHELL_NAMES = {"bash", "sh", "zsh"}
# Keep-nodes emitted in the forest. Internal kinds use *_cli names.
_KEEP_KINDS = frozenset({"claude_cli", "grok_cli", "cursor_cli", "agent_dispatch"})
_KIND_OUT = {
    "claude_cli": "claude",
    "grok_cli": "grok",
    "cursor_cli": "cursor",
    "agent_dispatch": "agent_dispatch",
}

# /v1/cli cache: one ps+classify per TTL window (default 5s).
_CLI_CACHE = {
    "payload": None,
    "mono": 0.0,
    "sweep_ms": 0.0,
    "sweep_count": 0,
}
_CLI_CACHE_LOCK = threading.Lock()
_MODEL_DEFAULTS = {"claude": None, "grok": None, "cursor": None, "loaded_at": 0.0}


def ps_cli_snapshot():
    """Rich process map for CLI classification (argv0/path identity).

    One call: ps -axo pid=,ppid=,tty=,lstart=,command=
    Returns {pid: {pid, ppid, tty, lstart, command}} or None on failure.
    """
    if os.name == "nt":
        return None
    try:
        out = subprocess.check_output(
            PS_CLI_CMD, text=True, stderr=subprocess.DEVNULL
        )
    except Exception:
        return None
    snap = {}
    for line in out.splitlines():
        m = _PS_CLI_LINE.match(line)
        if not m:
            continue
        pid_s, ppid_s, tty, lstart, command = m.groups()
        try:
            pid = int(pid_s)
            snap[pid] = {
                "pid": pid,
                "ppid": int(ppid_s),
                "tty": tty,
                "lstart": lstart,
                "command": command,
            }
        except ValueError:
            continue
    return snap


def ps_snapshot():
    """POSIX: one {pid: command} map per liveness pass (also defeats pid reuse).

    Derived from a single rich ps_cli_snapshot() — no second ps sweep.
    """
    rich = ps_cli_snapshot()
    if rich is None:
        return None
    return {pid: rec["command"] for pid, rec in rich.items()}


def proc_alive(pid, expect_substr=None, snap=None):
    """Alive AND (when identity is recorded) still the same program."""
    if not pid:
        return False
    if snap is not None:
        # Accept either thin {pid: cmd} or rich {pid: {command: ...}} maps.
        entry = snap.get(int(pid))
        if entry is None:
            return False
        cmd = entry["command"] if isinstance(entry, dict) else entry
        if expect_substr and expect_substr not in cmd:
            return False  # pid recycled by an unrelated process
        return True
    return pid_alive(pid)


def _argv0(command):
    return command.split(None, 1)[0] if command else ""


def _tokens(command):
    return command.split() if command else []


# Interpreter-script basenames. Used to reconstruct a space-bearing install
# path after python/shell argv0 (D1b): command.split() breaks "Internal
# Development" so toks[1] is a truncated prefix, not the script.
_PYTHON_SCRIPT_KINDS = {
    "agent-dispatch": "agent_dispatch",
    "team-dispatch": "agent_dispatch",
    "switchboard": "switchboard_daemon",
}
_SHELL_SCRIPT_KINDS = {
    "grok-ask": "grok_ask",
    "cursor-ask": "cursor_ask",
}


def _script_after_interpreter(toks, start, known):
    """Reconstruct a space-bearing script path in early argv (D1b).

    Structural path marker, same class as the app-bundle check: join tokens
    after the interpreter until basename is in `known`. Stop at a flag or a
    new `/`/`~` path so flag values and prompt text are never scanned (D1).
    Returns (basename if in known else None, index just after the script).
    """
    if start >= len(toks):
        return None, start
    t = toks[start]
    if t.startswith("-"):
        return None, start
    acc = t
    i = start
    while True:
        base = os.path.basename(acc)
        if base in known:
            return base, i + 1
        if i + 1 >= len(toks):
            return None, start
        nxt = toks[i + 1]
        if nxt.startswith("-") or nxt.startswith("/") or nxt.startswith("~"):
            return None, start
        acc = acc + " " + nxt
        i += 1


def viewer_process_match(command):
    """Viewer identity from argv0/path-position ONLY (never free-text prompt).

    Never pgrep -f "Agent Switchboard" (prompt-pollution class). App-bundle
    paths contain a space ("Agent Switchboard.app"), so a naive split of
    command into argv0 truncates early — that structural path marker is
    checked on the full command string. A path appearing as a flag value
    (`--cwd /x/agent-switchboard`, `--cwd=/x/agent-switchboard`) or inside
    prompt text is not a match.

    Remaining same-class full-command substring checks (audit; kept, not
    in this function): Claude.app exclusion in kind_from_command, and
    cursor-agent versions path in kind_from_command.
    """
    if not command:
        return False
    a0 = _argv0(command)
    if os.path.basename(a0) == "agent-switchboard":
        return True
    if "/agent-switchboard" in a0:
        return True
    # Space-bearing install path (argv0 split loses the rest of the path).
    if "/Agent Switchboard.app/Contents/MacOS/" in command:
        return True
    return False


def kind_from_command(command):
    """Classify a process from argv0/early argv ONLY (no free-text matching).

    Returns internal kind or None. Keep-nodes: claude_cli, grok_cli,
    cursor_cli, agent_dispatch. Classified-but-never-emitted: grok_ask,
    cursor_ask, switchboard_daemon, shell_tool, viewer.
    Claude.app helpers return None (excluded).

    Space-bearing install paths (e.g. ".../Internal Development/...") are
    recovered by joining early-argv path tokens until a known script
    basename — never by scanning flag values or prompt text (D1b).
    """
    if not command:
        return None
    # Desktop noise: full-path markers are not free-text prompts.
    # Same-class full-command substring check (audit; kept).
    if "/Applications/Claude.app/" in command or "Claude Helper" in command:
        return None
    a0 = _argv0(command)
    if viewer_process_match(command):
        return "viewer"
    b0 = os.path.basename(a0)
    toks = _tokens(command)

    if b0 in _PYTHON_NAMES and len(toks) >= 2:
        script, _ = _script_after_interpreter(toks, 1, _PYTHON_SCRIPT_KINDS)
        if script in _PYTHON_SCRIPT_KINDS:
            return _PYTHON_SCRIPT_KINDS[script]
        return None

    if b0 in _SHELL_NAMES and len(toks) >= 2:
        # -c/-lc is a flag, not a script path — do not reconstruct into the
        # prompt blob (D1).
        if toks[1] in ("-c", "-lc"):
            return "shell_tool"
        script, _ = _script_after_interpreter(toks, 1, _SHELL_SCRIPT_KINDS)
        if script in _SHELL_SCRIPT_KINDS:
            return _SHELL_SCRIPT_KINDS[script]
        # Pure tool shells (zsh -c / bash -c) — classify for completeness, never emit.
        return "shell_tool"

    # Direct argv0 is itself a space-bearing wrapper script (no interpreter
    # prefix). Reconstruct from toks[0] the same way.
    script0, _ = _script_after_interpreter(
        toks, 0, {**_PYTHON_SCRIPT_KINDS, **_SHELL_SCRIPT_KINDS}
    )
    if script0 in _PYTHON_SCRIPT_KINDS:
        return _PYTHON_SCRIPT_KINDS[script0]
    if script0 in _SHELL_SCRIPT_KINDS:
        return _SHELL_SCRIPT_KINDS[script0]

    if b0 == "cursor-ask" or a0.endswith("/cursor-ask"):
        return "cursor_ask"
    if (
        b0 == "cursor-agent"
        or a0.endswith("/cursor-agent")
        or "/.local/share/cursor-agent/" in a0
        or "/cursor-agent/versions/" in command  # same-class full-command check (audit; kept)
    ):
        return "cursor_cli"
    # node + cursor-agent index.js (exec -a failed / older launcher)
    if b0 == "node" and any("cursor-agent" in t for t in toks[:8]):
        return "cursor_cli"

    # Case-insensitive: Claude Code rewrites its process title to "CLAUDE"
    # (observed 2026-08-20, Fable 5 session), which made whole session trees
    # vanish and orphaned their cursor/grok children to top level.
    b0_l, a0_l = b0.lower(), a0.lower()
    if b0_l in ("claude", "claude.exe") or a0_l.endswith("/claude") or a0_l.endswith(
        "/claude.exe"
    ):
        return "claude_cli"
    if b0 in ("grok", "agent"):
        # Cache daemons, not agent sessions — never emit as forest nodes.
        if len(toks) >= 2 and toks[1] == "leader":
            return None
        if b0 == "agent" and len(toks) >= 2 and toks[1] == "serve":
            return None
        if len(toks) >= 3 and toks[1] == "agent" and toks[2] == "serve":
            return None
        return "grok_cli"
    if re.match(r"^grok-[\d.]+-macos-", b0) or re.match(r"^grok-macos-", b0):
        return "grok_cli"
    if "/.grok/bin/grok" in a0 or "/.grok/downloads/grok" in a0:
        return "grok_cli"
    # node + claude-code only in early tokens (legacy install)
    if b0 == "node" and any("claude-code" in t for t in toks[:6]):
        return "claude_cli"
    return None


def mode_from_tty(tty):
    return "headless" if (not tty or tty in ("??", "?")) else "interactive"


def _parse_wrapper_flags(command, kind):
    meta = {
        "channel": None,
        "cwd_arg": None,
        "task": None,
        "lane": None,
        "work_mode": False,
        "headless_flag": False,
        "model": None,
    }
    toks = _tokens(command)
    if not toks:
        return meta

    def take_model(toks, i):
        t = toks[i]
        if t in ("-m", "--model") and i + 1 < len(toks):
            return toks[i + 1], i + 2
        if t.startswith("--model="):
            return t.split("=", 1)[1], i + 1
        if t.startswith("-m=") and len(t) > 3:
            return t.split("=", 1)[1], i + 1
        return None, i

    if kind in ("grok_ask", "cursor_ask", "agent_dispatch"):
        i = 0
        if i < len(toks) and os.path.basename(toks[i]) in (_PYTHON_NAMES | _SHELL_NAMES):
            i += 1
        _wrap_names = {
            "grok-ask",
            "cursor-ask",
            "agent-dispatch",
            "team-dispatch",
        }
        if i < len(toks) and os.path.basename(toks[i]) in _wrap_names:
            i += 1
        else:
            # Space-bearing script path: skip reconstructed tokens so --task
            # / --lane after ".../Internal Development/.../agent-dispatch"
            # are still visible (D1b; T31b label).
            _, after = _script_after_interpreter(toks, i, _wrap_names)
            i = after
        while i < len(toks):
            t = toks[i]
            mval, ni = take_model(toks, i)
            if mval is not None:
                meta["model"] = mval
                i = ni
                continue
            if t in ("-c", "--channel") and i + 1 < len(toks):
                meta["channel"] = toks[i + 1]
                i += 2
                continue
            if t in ("-d", "--cwd") and i + 1 < len(toks):
                meta["cwd_arg"] = toks[i + 1]
                i += 2
                continue
            if t.startswith("--channel="):
                meta["channel"] = t.split("=", 1)[1]
                i += 1
                continue
            if t.startswith("--cwd="):
                meta["cwd_arg"] = t.split("=", 1)[1]
                i += 1
                continue
            if t in ("-w", "--work"):
                meta["work_mode"] = True
                i += 1
                continue
            if t in ("--task", "--lane", "--report", "--max", "--exec") and i + 1 < len(
                toks
            ):
                if t == "--task":
                    meta["task"] = toks[i + 1]
                if t == "--lane":
                    meta["lane"] = toks[i + 1]
                i += 2
                continue
            if t in ("--", "--replace"):
                i += 1
                continue
            if t.startswith("-"):
                i += 1
                continue
            break  # free-text prompt
        return meta

    if kind == "cursor_cli":
        # cursor-agent: -p/--print is headless; --workspace is the cwd.
        for t in toks[1:10]:
            if t in ("-p", "--print"):
                meta["headless_flag"] = True
                break
        for j in range(len(toks) - 1, 0, -1):
            t = toks[j]
            if t.startswith("--model="):
                meta["model"] = t.split("=", 1)[1]
                break
            if t.startswith("-m=") and len(t) > 3:
                meta["model"] = t.split("=", 1)[1]
                break
            if t in ("-m", "--model") and j + 1 < len(toks):
                meta["model"] = toks[j + 1]
                break
        for j, t in enumerate(toks):
            if t in ("--workspace", "-d", "--cwd") and j + 1 < len(toks) and toks[j + 1][:1] in "/~":
                meta["cwd_arg"] = toks[j + 1]
            elif t.startswith("--workspace=") and t.split("=", 1)[1][:1] in "/~":
                meta["cwd_arg"] = t.split("=", 1)[1]
            elif t.startswith("--cwd=") and t.split("=", 1)[1][:1] in "/~":
                meta["cwd_arg"] = t.split("=", 1)[1]
        return meta

    if kind == "grok_cli":
        if len(toks) >= 2 and toks[1] == "-p":
            meta["headless_flag"] = True
        # End-scan so a real flag after `-p <prompt>` wins over lookalikes
        # inside the prompt blob (same class as the Claude --model fix).
        for j in range(len(toks) - 1, 0, -1):
            t = toks[j]
            if t.startswith("--model="):
                meta["model"] = t.split("=", 1)[1]
                break
            if t.startswith("-m=") and len(t) > 3:
                meta["model"] = t.split("=", 1)[1]
                break
            if t in ("-m", "--model") and j + 1 < len(toks):
                meta["model"] = toks[j + 1]
                break
        for j, t in enumerate(toks):
            if t == "--cwd" and j + 1 < len(toks) and toks[j + 1][:1] in "/~":
                meta["cwd_arg"] = toks[j + 1]
            elif t.startswith("--cwd=") and t.split("=", 1)[1][:1] in "/~":
                meta["cwd_arg"] = t.split("=", 1)[1]
        return meta

    if kind == "claude_cli":
        # -p/--print is an early flag, so the leading window is right for it.
        for t in toks[1:8]:
            if t in ("-p", "--print"):
                meta["headless_flag"] = True
                break
        # --model is NOT early: `claude -p <prompt> ... --model sonnet` puts it
        # after a prompt that ps splits into hundreds of tokens. Scan from the
        # END so the real flag wins over any lookalike inside the prompt text
        # (a leading-window scan never sees it, and every dispatched Claude
        # lane would report the session default instead of its actual model).
        for j in range(len(toks) - 1, 0, -1):
            t = toks[j]
            if t.startswith("--model="):
                meta["model"] = t.split("=", 1)[1]
                break
            if t in ("-m", "--model") and j + 1 < len(toks):
                meta["model"] = toks[j + 1]
                break
        return meta

    # Best-effort -m scan for other kinds
    for j, t in enumerate(toks):
        if t in ("-m", "--model") and j + 1 < len(toks):
            meta["model"] = toks[j + 1]
            break
        if t.startswith("--model="):
            meta["model"] = t.split("=", 1)[1]
            break
    return meta


def _toml_models_default(text):
    """Parse [models] default (also model/default_model) from a TOML blob.

    Table-aware: ignores [ui] fork_secondary_model and a stray top-level
    default =. Never invents a version string.
    """
    if not text:
        return None
    section = None
    found = None
    for raw in text.splitlines():
        s = raw.strip()
        if not s or s.startswith("#"):
            continue
        if s.startswith("[") and s.endswith("]"):
            section = s[1:-1].strip().strip('"').strip("'")
            continue
        if "=" not in s:
            continue
        key, _, val = s.partition("=")
        key = key.strip()
        val = val.split("#", 1)[0].strip().strip('"').strip("'")
        if section == "models" and key in (
            "default",
            "model",
            "default_model",
            "defaultModel",
        ):
            if val:
                if key == "default":
                    return val
                if found is None:
                    found = val
    return found


def _cursor_config_model(data):
    """Display id from ~/.cursor/cli-config.json. Never invents a version."""
    if not isinstance(data, dict):
        return None
    model = data.get("model") if isinstance(data.get("model"), dict) else {}
    selected = data.get("selectedModel") if isinstance(data.get("selectedModel"), dict) else {}
    for key in (
        model.get("displayModelId"),
        model.get("displayNameShort"),
        model.get("displayName"),
        selected.get("modelId"),
        model.get("modelId"),
    ):
        if key:
            return str(key)
    return None


def cursor_channel_model(channel):
    """model field from a cursor-ask channel state file, or None."""
    if not channel or not name_ok(channel):
        return None
    data = read_json(os.path.join(CURSOR_CHANNEL_DIR, "%s.json" % channel)) or {}
    mid = data.get("model")
    return mid if mid else None


def _load_model_defaults(now=None):
    """Read claude/grok/cursor default models once per short window.

    Grok default is [models].default or None — never a hardcoded version.
    Cursor default is cli-config display id or None.
    """
    now = now if now is not None else time.time()
    if _MODEL_DEFAULTS["loaded_at"] and (now - _MODEL_DEFAULTS["loaded_at"]) < 60:
        return (
            _MODEL_DEFAULTS["claude"],
            _MODEL_DEFAULTS["grok"],
            _MODEL_DEFAULTS["cursor"],
        )

    claude_default = "default"
    try:
        data = read_json(CLAUDE_SETTINGS_PATH) or {}
        claude_default = (
            data.get("defaultModel") or data.get("model") or "default"
        )
    except Exception:
        pass

    grok_default = None
    try:
        with open(GROK_CONFIG_PATH) as f:
            grok_default = _toml_models_default(f.read())
    except Exception:
        pass

    cursor_default = None
    try:
        cursor_default = _cursor_config_model(read_json(CURSOR_CONFIG_PATH) or {})
    except Exception:
        pass

    _MODEL_DEFAULTS["claude"] = claude_default
    _MODEL_DEFAULTS["grok"] = grok_default
    _MODEL_DEFAULTS["cursor"] = cursor_default
    _MODEL_DEFAULTS["loaded_at"] = now
    return claude_default, grok_default, cursor_default


def reset_model_defaults():
    """Test helper: drop the 60s config cache."""
    _MODEL_DEFAULTS["claude"] = None
    _MODEL_DEFAULTS["grok"] = None
    _MODEL_DEFAULTS["cursor"] = None
    _MODEL_DEFAULTS["loaded_at"] = 0.0


def _lstart_ts(lstart):
    try:
        return datetime.datetime.strptime(lstart, "%a %b %d %H:%M:%S %Y").timestamp()
    except Exception:
        return None


def _grok_resume_sid(command):
    """Session id from a grok CLI command's --resume flag (None if absent)."""
    toks = _tokens(command)
    for i, t in enumerate(toks):
        if t == "--resume" and i + 1 < len(toks):
            return toks[i + 1]
        if t.startswith("--resume="):
            return t.split("=", 1)[1]
    return None


def _parse_iso_ts(s):
    """Parse a grok/claude ISO timestamp to epoch seconds (UTC). None on fail."""
    if not s or not isinstance(s, str):
        return None
    raw = s.strip()
    try:
        if raw.endswith("Z"):
            raw = raw[:-1] + "+00:00"
        dt = datetime.datetime.fromisoformat(raw[:32])
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return dt.timestamp()
    except ValueError:
        try:
            return (
                datetime.datetime.strptime(s[:19], "%Y-%m-%dT%H:%M:%S")
                .replace(tzinfo=datetime.timezone.utc)
                .timestamp()
            )
        except ValueError:
            return None


def _proc_cwd(pid):
    """Best-effort cwd of a live pid. Never raises. Tests with fake pids → None."""
    if not pid:
        return None
    if os.name != "nt":
        try:
            return os.readlink("/proc/%d/cwd" % int(pid))
        except Exception:
            pass
        try:
            out = subprocess.check_output(
                ["lsof", "-a", "-p", str(int(pid)), "-d", "cwd", "-Fn"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=0.4,
            )
            for line in out.splitlines():
                if line.startswith("n"):
                    return line[1:]
        except Exception:
            pass
    return None


def _grok_cwd_root(cwd):
    if not cwd:
        return None
    cwd = os.path.expanduser(cwd)
    return os.path.join(GROK_SESS_ROOT, urllib.parse.quote(cwd, safe=""))


def grok_session_model(cwd, sid):
    """current_model_id from summary.json, or None. Never invents a version."""
    if not sid or not cwd:
        return None
    path = os.path.join(_grok_cwd_root(cwd), sid, "summary.json")
    data = read_json(path) or {}
    mid = data.get("current_model_id")
    return mid if mid else None


def _grok_sid_from_active_sessions(pid):
    """pid → (session_id, cwd) from grok's live TUI map. (None, None) if missing."""
    if pid is None:
        return None, None
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None, None
    data = read_json(GROK_ACTIVE_SESSIONS)
    if not isinstance(data, list):
        return None, None
    hits = []
    for row in data:
        if not isinstance(row, dict):
            continue
        try:
            if int(row.get("pid")) != pid:
                continue
        except (TypeError, ValueError):
            continue
        sid = row.get("session_id")
        if sid and name_ok(str(sid)):
            cwd = row.get("cwd")
            hits.append((str(sid), cwd if isinstance(cwd, str) else None))
    if len(hits) == 1:
        return hits[0]
    return None, None


def resolve_grok_sid(command, rec, cwd_arg, started_ts):
    """Sid for a grok process: --resume, else active_sessions.json, else cwd match.

    Ambiguous (several sessions in the start window, or none) → (None, cwd).
    Never guesses the newest session in a shared cwd.
    """
    sid = _grok_resume_sid(command)
    cwd = cwd_arg
    if sid:
        if not cwd and rec:
            cwd = _proc_cwd(rec.get("pid"))
        return sid, cwd
    mapped_sid, mapped_cwd = _grok_sid_from_active_sessions(
        rec.get("pid") if rec else None
    )
    if mapped_sid:
        return mapped_sid, cwd or mapped_cwd
    if not cwd and rec:
        cwd = _proc_cwd(rec.get("pid"))
    if not cwd:
        return None, None
    root = _grok_cwd_root(cwd)
    if not root or not os.path.isdir(root):
        return None, cwd
    try:
        names = os.listdir(root)
    except OSError:
        return None, cwd

    def _summaries():
        for name in names:
            summary = read_json(os.path.join(root, name, "summary.json"))
            if not summary or summary.get("session_kind") == "subagent":
                continue
            yield name, summary

    # 1. created_at within the process start window (first session of a process).
    window = []
    if started_ts is not None:
        for name, summary in _summaries():
            created = _parse_iso_ts(summary.get("created_at"))
            if created is None:
                continue
            if started_ts - 60 <= created <= started_ts + 180:
                window.append(name)
        if len(window) == 1:
            return window[0], cwd

    # 2. Unique session holding a lock file (interactive TUI writes these).
    locked = []
    for name, _summary in _summaries():
        sdir = os.path.join(root, name)
        if any(
            os.path.exists(os.path.join(sdir, lf))
            for lf in (
                "summary.json.lock",
                "chat_history.jsonl.lock",
                "updates.jsonl.lock",
            )
        ):
            locked.append(name)
    if len(locked) == 1:
        return locked[0], cwd

    # 3. Unique recently-active session (covers /clear in a long-lived TUI:
    #    process lstart no longer matches created_at).
    now = time.time()
    hot = []
    for name, summary in _summaries():
        la = _parse_iso_ts(
            summary.get("last_active_at") or summary.get("updated_at")
        )
        if la is not None and now - la < 90:
            hot.append(name)
    if len(hot) == 1:
        return hot[0], cwd
    return None, cwd


def grok_active_subagents(sid, proc_started_ts, now, parent_model=None):
    """Virtual tree nodes for a grok session's ACTIVE in-process subagents.

    Native grok subagents (spawn_subagent) run inside the parent's OS process, so
    the ps forest can never show them spreading. Their ground truth lives in
    the session dir: subagents/<id>/meta.json carries status/started_at/
    description. Active = status not "completed"/"cancelled" AND started
    at/after this grok process (a resumed session keeps stale entries from
    earlier runs). Sid may come from --resume OR resolve_grok_sid().
    Children stay flat (Grok forbids nest depth > 1). Model is
    effective_model_id, else the parent process model, else null — never a
    hardcoded version.
    """
    if not sid or not name_ok(sid):
        return []
    out = []
    pattern = os.path.join(
        GROK_SESS_ROOT, "*", sid, "subagents", "*", "meta.json"
    )
    for meta_path in glob.glob(pattern):
        m = read_json(meta_path)
        if not m or m.get("status") in ("completed", "cancelled"):
            continue
        ts = _parse_iso_ts(m.get("started_at"))
        if (
            proc_started_ts is not None
            and ts is not None
            and ts < proc_started_ts - 60
        ):
            continue
        started_iso = iso(ts) if ts is not None else None
        model = m.get("effective_model_id") or parent_model
        out.append({
            "pid": None,
            "kind": "grok-sub",
            "mode": "headless",
            "tty": None,
            "started": started_iso,
            "started_iso": started_iso,
            "uptime_s": max(0, int(round(now - ts))) if ts is not None else None,
            "label": m.get("description") or m.get("subagent_type") or "subagent",
            "model": model,
            "children": [],
            "virtual": True,
            "subagent_id": m.get("subagent_id"),
            "status": m.get("status"),
        })
    out.sort(key=lambda n: n.get("started") or "")
    return out


def _reattach_dispatch_orphans(nodes, roots):
    """Move agent_dispatch roots under their recorded launcher keep-node.

    Only attaches when launcher_cli_pid is a live keep-node of matching
    kind. Ambiguous / stale / missing → leave as root (honest forest).
    """
    if not roots:
        return roots
    kept = []
    for r in roots:
        if r.get("kind") != "agent_dispatch":
            kept.append(r)
            continue
        task, lane = r.get("task"), r.get("lane")
        if not task or not lane or not name_ok(task) or not name_ok(lane):
            kept.append(r)
            continue
        slot = read_json(os.path.join(task_dir(task), "slot-%s.json" % lane)) or {}
        lp = slot.get("launcher_cli_pid")
        lk = slot.get("launcher_cli_kind")
        try:
            lp = int(lp) if lp is not None else None
        except (TypeError, ValueError):
            lp = None
        parent = nodes.get(lp) if lp is not None else None
        if parent is None:
            kept.append(r)
            continue
        want = {
            "claude": "claude",
            "claude_cli": "claude",
            "grok": "grok",
            "grok_cli": "grok",
            "cursor": "cursor",
            "cursor_cli": "cursor",
        }.get(lk, lk)
        if want and parent.get("kind") != want:
            kept.append(r)
            continue
        # Refuse cycles (should be impossible; belt and braces).
        walk = parent
        cyclic = False
        seen = set()
        while walk is not None:
            wid = walk.get("pid")
            if wid in seen:
                cyclic = True
                break
            seen.add(wid)
            if walk is r:
                cyclic = True
                break
            # parent pointer is not stored; only check identity
            break
        if cyclic or parent is r:
            kept.append(r)
            continue
        parent.setdefault("children", []).append(r)
    return kept


def build_cli_forest(snap, now=None):
    """Collapse shims and reattach keep-nodes: pure function on a process snap.

    1. Classify from ONE snap.
    2. Keep-nodes: claude_cli | grok_cli | cursor_cli | agent_dispatch only.
    3. Never emit: grok_ask, cursor_ask, pure shells, switchboard_daemon,
       Claude.app, viewer.
    4. Re-parent each keep-node to the first keep-node on its ancestor chain
       (walk at most 10). Roots = keep-nodes with no keep-ancestor.
    5. Labels: agent_dispatch task/lane; grok/cursor channel from nearest
       collapsed grok_ask/cursor_ask + task/lane from agent_dispatch ancestor;
       claude tty or (exec-master) when headless/-p.
    6. kind enum out: claude | grok | cursor | agent_dispatch (+ virtual
       grok-sub children grafted onto resumed grok nodes). Counts exclude
       agent_dispatch. Cursor slaves that are real OS processes nest via PPID.
    Every node carries both started and started_iso (same ISO string) + model.
    """
    now = now if now is not None else time.time()
    if not snap:
        return {
            "counts": {
                "claude": {"interactive": 0, "headless": 0},
                "grok": {"interactive": 0, "headless": 0},
                "cursor": {"interactive": 0, "headless": 0},
                "grok_subagents": 0,
                "cursor_subagents": 0,
                "totals": {"claude": 0, "grok": 0, "cursor": 0, "live": 0},
            },
            "roots": [],
        }

    claude_def, grok_def, cursor_def = _load_model_defaults(now)

    # Classify every process once.
    kinds = {}  # pid -> kind or None
    for pid, rec in snap.items():
        kinds[pid] = kind_from_command(rec.get("command") or "")

    keep_pids = [pid for pid, k in kinds.items() if k in _KEEP_KINDS]

    def walk_ancestors(pid, maxd=10):
        """Yield ancestor pids walking ppid (not including pid itself), ≤maxd."""
        seen = set()
        cur = snap.get(pid, {}).get("ppid")
        for _ in range(maxd):
            if cur is None or cur in seen:
                break
            seen.add(cur)
            yield cur
            if cur not in snap:
                break
            cur = snap[cur].get("ppid")

    def first_keep_ancestor(pid):
        for anc in walk_ancestors(pid, 10):
            if kinds.get(anc) in _KEEP_KINDS:
                return anc
        return None

    def nearest_kind_ancestor(pid, want):
        for anc in walk_ancestors(pid, 10):
            if kinds.get(anc) == want:
                return anc
        return None

    # Build node dicts keyed by pid.
    nodes = {}
    grok_sess = {}  # pid -> (resume sid, proc started_ts) for grok_cli nodes
    for pid in keep_pids:
        rec = snap[pid]
        ikind = kinds[pid]
        cmd = rec.get("command") or ""
        meta = _parse_wrapper_flags(cmd, ikind)
        mode = mode_from_tty(rec.get("tty"))
        if meta.get("headless_flag"):
            mode = "headless"

        # Labels + inheritance
        label = None
        channel = None
        task = meta.get("task")
        lane = meta.get("lane")
        model = meta.get("model")

        if ikind == "agent_dispatch":
            if task and lane:
                label = f"{task}/{lane}"
            elif task:
                label = task
            elif lane:
                label = lane
        elif ikind == "grok_cli":
            ask = nearest_kind_ancestor(pid, "grok_ask")
            if ask is not None:
                am = _parse_wrapper_flags(snap[ask].get("command") or "", "grok_ask")
                channel = am.get("channel")
                if not meta.get("cwd_arg"):
                    meta["cwd_arg"] = am.get("cwd_arg")
                if not model:
                    model = am.get("model")
            td = nearest_kind_ancestor(pid, "agent_dispatch")
            if td is not None:
                tm = _parse_wrapper_flags(
                    snap[td].get("command") or "", "agent_dispatch"
                )
                task = tm.get("task")
                lane = tm.get("lane")
                if not channel:
                    channel = tm.get("channel")
            label = channel
        elif ikind == "cursor_cli":
            ask = nearest_kind_ancestor(pid, "cursor_ask")
            if ask is not None:
                am = _parse_wrapper_flags(
                    snap[ask].get("command") or "", "cursor_ask"
                )
                channel = am.get("channel")
                if not meta.get("cwd_arg"):
                    meta["cwd_arg"] = am.get("cwd_arg")
                if not model:
                    model = am.get("model")
            td = nearest_kind_ancestor(pid, "agent_dispatch")
            if td is not None:
                tm = _parse_wrapper_flags(
                    snap[td].get("command") or "", "agent_dispatch"
                )
                task = tm.get("task")
                lane = tm.get("lane")
                if not channel:
                    channel = tm.get("channel")
                if not model:
                    model = tm.get("model")
            if not model and channel:
                model = cursor_channel_model(channel)
            label = channel
        elif ikind == "claude_cli":
            if mode == "headless" or meta.get("headless_flag"):
                # A dispatched Claude lane carries its identity on the
                # agent_dispatch ancestor, exactly like a grok lane does. Recover
                # it instead of guessing. A headless claude with no dispatch
                # ancestor is an exec-master (or ad-hoc claude -p), not a
                # dispatched lane executor.
                td = nearest_kind_ancestor(pid, "agent_dispatch")
                if td is not None:
                    tm = _parse_wrapper_flags(
                        snap[td].get("command") or "", "agent_dispatch"
                    )
                    task = task or tm.get("task")
                    lane = lane or tm.get("lane")
                    if not channel:
                        channel = tm.get("channel")
                    if not meta.get("cwd_arg"):
                        meta["cwd_arg"] = tm.get("cwd_arg")
                if lane:
                    label = f"{task}/{lane}" if task else lane
                else:
                    # Headless claude with no dispatch ancestor: a real
                    # exec-master (Agent-tool subagent) or an ad-hoc claude -p.
                    label = "(exec-master)"
            else:
                label = None  # viewer shows tty from node.tty

        started_ts = _lstart_ts(rec.get("lstart"))
        if started_ts is not None:
            started_iso = iso(started_ts)
            uptime_s = max(0, int(round(now - started_ts)))
        else:
            started_iso = None
            uptime_s = None

        # Grok model: argv → grok-ask inherit → session summary → config.
        # Never invent a version string.
        if ikind == "grok_cli":
            sid, sess_cwd = resolve_grok_sid(
                cmd, rec, meta.get("cwd_arg"), started_ts
            )
            if sid:
                grok_sess[pid] = (sid, started_ts)
            if not model and sid:
                model = grok_session_model(sess_cwd, sid)

        if not model:
            if ikind == "claude_cli":
                model = claude_def
            elif ikind == "grok_cli":
                model = grok_def
            elif ikind == "cursor_cli":
                model = cursor_def
            else:
                model = None

        tty = rec.get("tty")
        if mode == "headless" or not tty or tty in ("??", "?"):
            tty_out = None
        else:
            tty_out = tty

        nodes[pid] = {
            "pid": pid,
            "kind": _KIND_OUT[ikind],
            "mode": mode,
            "tty": tty_out,
            "started": started_iso,
            "started_iso": started_iso,
            "uptime_s": uptime_s,
            "label": label,
            "model": model,
            "children": [],
        }
        if channel:
            nodes[pid]["channel"] = channel
        if task:
            nodes[pid]["task"] = task
        if lane:
            nodes[pid]["lane"] = lane

    # Re-parent: attach each keep-node under first keep-ancestor (≤10 walk).
    roots = []
    for pid in sorted(keep_pids):
        parent = first_keep_ancestor(pid)
        if parent is not None and parent in nodes:
            nodes[parent]["children"].append(nodes[pid])
        else:
            roots.append(nodes[pid])

    # Logical reattach: a backgrounded agent-dispatch is reparented to pid 1.
    # Slot launcher_cli_pid (written at dispatch while the parent was live)
    # is the only safe pointer — refuse on dead/mismatched/ambiguous.
    roots = _reattach_dispatch_orphans(nodes, roots)

    # Stable child order by pid.
    def sort_tree(node):
        node["children"].sort(key=lambda c: (c["pid"] is None, c["pid"] or 0))
        for c in node["children"]:
            sort_tree(c)

    for r in roots:
        sort_tree(r)
    roots.sort(key=lambda n: n["pid"] if n.get("pid") is not None else 0)

    # Graft virtual grok-sub children AFTER sort_tree (their pid is None,
    # which the pid sort key cannot order).
    sub_total = 0
    for pid, (sid, sts) in grok_sess.items():
        node = nodes.get(pid)
        if not node:
            continue
        subs = grok_active_subagents(sid, sts, now, parent_model=node.get("model"))
        node["children"].extend(subs)
        sub_total += len(subs)

    counts = {
        "claude": {"interactive": 0, "headless": 0},
        "grok": {"interactive": 0, "headless": 0},
        "cursor": {"interactive": 0, "headless": 0},
        "grok_subagents": 0,
        "cursor_subagents": 0,
    }

    def count_walk(node):
        k = node["kind"]
        if k in ("claude", "grok", "cursor"):
            m = node["mode"] if node["mode"] in ("interactive", "headless") else "headless"
            counts[k][m] += 1
        elif k == "grok-sub":
            counts["grok_subagents"] += 1
        elif k == "cursor-sub":
            counts["cursor_subagents"] += 1
        for c in node.get("children") or []:
            count_walk(c)

    for r in roots:
        count_walk(r)

    counts["totals"] = {
        "claude": counts["claude"]["interactive"] + counts["claude"]["headless"],
        "grok": (
            counts["grok"]["interactive"]
            + counts["grok"]["headless"]
            + counts["grok_subagents"]
        ),
        "cursor": (
            counts["cursor"]["interactive"]
            + counts["cursor"]["headless"]
            + counts["cursor_subagents"]
        ),
    }
    counts["totals"]["live"] = (
        counts["totals"]["claude"]
        + counts["totals"]["grok"]
        + counts["totals"]["cursor"]
    )

    return {"counts": counts, "roots": roots}


def cli_busy(snap=None):
    """True if any claude_cli, grok_cli, or cursor_cli process is present.

    Viewer / agent_dispatch / grok_ask / cursor_ask / switchboard are NOT CLI
    instances.
    """
    if snap is None:
        snap = ps_cli_snapshot()
    if not snap:
        return False
    for rec in snap.values():
        cmd = rec["command"] if isinstance(rec, dict) else rec
        k = kind_from_command(cmd)
        if k in ("claude_cli", "grok_cli", "cursor_cli"):
            return True
    return False


def viewer_running(snap=None):
    """True if Agent Switchboard GUI is running (argv0/path rule).

    Never uses pgrep -f on display name (prompt-pollution bug class).
    Viewer is NOT counted as a CLI instance.
    """
    if snap is None:
        snap = ps_cli_snapshot()
    if not snap:
        return False
    for rec in snap.values():
        cmd = rec["command"] if isinstance(rec, dict) else rec
        if viewer_process_match(cmd):
            return True
    return False


def get_cli_payload(boot_id=None, force=False, now=None):
    """Build /v1/cli response with 5s TTL cache (one ps sweep per window)."""
    now_wall = now if now is not None else time.time()
    mono = time.monotonic()
    with _CLI_CACHE_LOCK:
        if (
            not force
            and _CLI_CACHE["payload"] is not None
            and (mono - _CLI_CACHE["mono"]) < CLI_CACHE_TTL
        ):
            payload = dict(_CLI_CACHE["payload"])
            payload["ts"] = iso(now_wall)
            if boot_id is not None:
                payload["boot_id"] = boot_id
            payload["cached"] = True
            payload["sweep_ms"] = _CLI_CACHE["sweep_ms"]
            payload["sweep_count"] = _CLI_CACHE["sweep_count"]
            return payload

        t0 = time.monotonic()
        snap = ps_cli_snapshot()
        forest = build_cli_forest(snap or {}, now=now_wall)
        sweep_ms = round((time.monotonic() - t0) * 1000.0, 2)
        _CLI_CACHE["sweep_count"] = _CLI_CACHE["sweep_count"] + 1
        _CLI_CACHE["sweep_ms"] = sweep_ms
        _CLI_CACHE["mono"] = mono
        payload = {
            "ts": iso(now_wall),
            "boot_id": boot_id,
            "counts": forest["counts"],
            "roots": forest["roots"],
            "cached": False,
            "sweep_ms": sweep_ms,
            "sweep_count": _CLI_CACHE["sweep_count"],
        }
        # Cache without volatile ts/boot_id? We re-stamp on hit; store structure.
        _CLI_CACHE["payload"] = {
            "counts": forest["counts"],
            "roots": forest["roots"],
        }
        print(
            f"switchboard cli: sweep {sweep_ms:.1f}ms "
            f"(claude={forest['counts']['claude']} grok={forest['counts']['grok']} "
            f"cursor={forest['counts'].get('cursor')})",
            file=sys.stderr,
        )
        return payload


def reset_cli_cache():
    """Test helper: clear /v1/cli TTL cache and sweep counter."""
    with _CLI_CACHE_LOCK:
        _CLI_CACHE["payload"] = None
        _CLI_CACHE["mono"] = 0.0
        _CLI_CACHE["sweep_ms"] = 0.0
        _CLI_CACHE["sweep_count"] = 0


# ---------------------------------------------------------------- slot reading


def session_dir_for(slot):
    """Best-effort: locate the grok CLI session dir backing this lane.
    Reliable only when the lane has a session_id (resumed channel) or a
    unique -d per lane; documented in INTEGRATIONS.md."""
    cwd = slot.get("cwd")
    if not cwd:
        return None
    root = os.path.join(GROK_SESS_ROOT, urllib.parse.quote(cwd, safe=""))
    sid = slot.get("session_id")
    if sid:
        d = os.path.join(root, sid)
        if os.path.isdir(d):
            return d
    best = None
    candidates = 0
    try:
        for name in os.listdir(root):
            d = os.path.join(root, name)
            if not os.path.isdir(d):
                continue
            summary = read_json(os.path.join(d, "summary.json")) or {}
            if summary.get("session_kind") == "subagent":
                continue
            st = os.stat(d)
            birth = getattr(st, "st_birthtime", st.st_mtime)
            if birth >= slot.get("started", 0) - 5:
                candidates += 1
                if best is None or birth < best[0]:
                    best = (birth, d)
    except FileNotFoundError:
        return None
    # Shared cwd with several matching sessions: refuse rather than steal.
    if candidates > 1:
        return None
    return best[1] if best else None


def claude_project_dir(cwd):
    """Claude encodes /Users/foo → -Users-foo under ~/.claude/projects."""
    if not cwd:
        return None
    cwd = os.path.abspath(os.path.expanduser(cwd))
    enc = cwd.replace("/", "-")
    return os.path.join(CLAUDE_PROJECTS_ROOT, enc)


def claude_transcript_for(slot):
    """Best-effort Claude jsonl path for a lane. None if missing/ambiguous."""
    d = claude_project_dir(slot.get("cwd"))
    if not d or not os.path.isdir(d):
        return None
    sid = slot.get("claude_session_id")
    if sid:
        p = os.path.join(d, "%s.jsonl" % sid)
        if os.path.isfile(p):
            return p
    newest = None
    count = 0
    try:
        for name in os.listdir(d):
            if not name.endswith(".jsonl"):
                continue
            p = os.path.join(d, name)
            if not os.path.isfile(p):
                continue
            try:
                mtime = os.path.getmtime(p)
            except OSError:
                continue
            if mtime < slot.get("started", 0) - 5:
                continue
            count += 1
            if newest is None or mtime > newest[0]:
                newest = (mtime, p)
    except OSError:
        return None
    if count != 1:
        return None
    return newest[1]


def _file_mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return None


def _tail_last_json(path, max_bytes=8192):
    """Last JSON object in a jsonl file, reading only the tail. None on fail."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            if size > max_bytes:
                f.seek(size - max_bytes)
            data = f.read().decode("utf-8", "replace")
    except OSError:
        return None
    last = None
    for line in data.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            last = json.loads(line)
        except ValueError:
            continue
    return last


def _newest_under(dirpath, suffix=None):
    newest = 0.0
    if not dirpath or not os.path.isdir(dirpath):
        return 0.0
    try:
        for name in os.listdir(dirpath):
            if suffix and not name.endswith(suffix):
                continue
            try:
                newest = max(newest, os.path.getmtime(os.path.join(dirpath, name)))
            except OSError:
                pass
    except OSError:
        return 0.0
    return newest


def heartbeat(slot):
    """Derived activity for a live slot. Never raises.

    Returns dict: age (seconds or None), phase, event, tool, growing,
    waiting_input, open_tool.
    """
    now = time.time()
    newest = 0.0
    last = None
    waiting_input = False
    open_tool = False
    growing = False

    d = session_dir_for(slot)
    if d:
        for name in ("updates.jsonl", "events.jsonl", "chat_history.jsonl"):
            mt = _file_mtime(os.path.join(d, name))
            if mt:
                newest = max(newest, mt)
        ev = _tail_last_json(os.path.join(d, "events.jsonl"))
        if isinstance(ev, dict):
            last = ev
            et = ev.get("type") or ""
            phase = ev.get("phase") or ""
            if et in ("permission_requested",) or phase == "permission_prompt":
                waiting_input = True
            if et == "tool_started" or phase == "tool_execution":
                open_tool = True
        term_mt = _newest_under(os.path.join(d, "terminal"))
        if term_mt:
            newest = max(newest, term_mt)
            if now - term_mt < 30:
                growing = True

    # cursor-ask lanes: channel jsonl is the activity heartbeat.
    ch = slot.get("channel")
    prog_base = slot.get("prog_base") or ""
    if ch and (
        prog_base == "cursor-ask"
        or "cursor-ask" in (slot.get("prog") or "")
        or slot.get("provider") == "cursor"
    ):
        log_p = os.path.join(CURSOR_LOG_DIR, "%s.jsonl" % ch)
        mt = _file_mtime(log_p)
        if mt:
            newest = max(newest, mt)
            if now - mt < 30:
                growing = True
        ev = _tail_last_json(log_p)
        if isinstance(ev, dict) and last is None:
            last = ev
        st_p = os.path.join(CURSOR_CHANNEL_DIR, "%s.json" % ch)
        mt = _file_mtime(st_p)
        if mt:
            newest = max(newest, mt)

    claude_p = claude_transcript_for(slot)
    if claude_p:
        mt = _file_mtime(claude_p)
        if mt:
            newest = max(newest, mt)
        ev = _tail_last_json(claude_p)
        if isinstance(ev, dict) and last is None:
            last = ev
            t = ev.get("type") or ""
            if t in ("assistant", "tool_use", "tool_result"):
                if now - (mt or 0) < 30:
                    growing = True

    report = slot.get("report")
    if report:
        mt = _file_mtime(report)
        if mt:
            newest = max(newest, mt)
            if now - mt < 30:
                growing = True

    age = (now - newest) if newest else None
    return {
        "age": age,
        "phase": (last or {}).get("phase"),
        "event": (last or {}).get("type"),
        "tool": (last or {}).get("tool_name"),
        "growing": growing,
        "waiting_input": waiting_input,
        "open_tool": open_tool,
    }


def activity_age(slot):
    hb = heartbeat(slot)
    return hb.get("age")


def _stall_budget(explicit=None):
    """Stall budget: explicit arg, else current env, else the import default.

    Read env on every call so `AGENT_SWITCHBOARD_STALL_AFTER=1 switchboard status`
    works (import-time DEFAULT_STALL_AFTER is only the fallback).
    """
    if explicit is not None:
        return explicit
    raw = os.environ.get("AGENT_SWITCHBOARD_STALL_AFTER")
    if raw:
        try:
            return float(raw)
        except ValueError:
            pass
    return DEFAULT_STALL_AFTER


def _done_expire():
    """Seconds after which terminal slots are omitted from served status.

    Read env on every call so `AGENT_SWITCHBOARD_DONE_EXPIRE=1 switchboard status`
    works (import-time DONE_EXPIRE_S is only the documented default). 0 disables.
    """
    raw = os.environ.get("AGENT_SWITCHBOARD_DONE_EXPIRE")
    if raw is not None and raw != "":
        try:
            return float(raw)
        except ValueError:
            pass
    return 900.0


def derive(slot, quiet_after=DEFAULT_QUIET_AFTER, snap=None, stall_after=None):
    """-> (STATE, activity_age_or_None)"""
    stall_after = _stall_budget(stall_after)
    if slot.get("corrupt"):
        return ("CORRUPT", None)
    if slot.get("status") == "exited":
        return ("DONE" if slot.get("exit_code") == 0 else "FAILED", None)
    child_ok = proc_alive(slot.get("pid"), slot.get("prog_base"), snap)
    wrapper_ok = proc_alive(slot.get("wrapper_pid"), slot.get("wrapper_base", "agent-dispatch"), snap)
    if not child_ok and not wrapper_ok:
        return ("DIED", None)  # silent kill: nobody left to finalize
    if child_ok and not wrapper_ok:
        return ("ORPHAN", activity_age(slot))
    if not child_ok and wrapper_ok:
        # worker just exited; wrapper is finalizing — NOT a death (audit #1)
        return ("RUNNING", None)
    hb = heartbeat(slot)
    age = hb.get("age")
    if hb.get("waiting_input"):
        return ("WAITING_INPUT", age)
    if hb.get("open_tool") and hb.get("growing"):
        return ("WORKING_TOOL", age)
    started = slot.get("started") or 0
    silence = age if age is not None else (time.time() - started if started else None)
    # dispatched lanes are headless; use the short stall budget.
    if silence is not None and silence > stall_after:
        return ("STALLED", age if age is not None else silence)
    if age is not None and age > quiet_after:
        return ("QUIET", age)
    return ("RUNNING", age)


def load_slots(task):
    out = {}
    for path in sorted(glob.glob(os.path.join(task_dir(task), "slot-*.json"))):
        lane = os.path.basename(path)[5:-5]
        slot = read_json(path)
        if slot is None:
            # unreadable slot must be VISIBLE, never silently dropped (audit #8)
            slot = {"lane": lane, "corrupt": True}
        try:
            slot["_mtime"] = os.stat(path).st_mtime
        except OSError:
            pass
        out[slot.get("lane", lane)] = slot
    return out


TERMINAL_STATES = ("DONE", "FAILED", "DIED")
# Busy predicate third OR-term: any slot in one of these states, across
# ALL tasks, counts as active (not just the CLI/viewer process checks).
ACTIVE_SLOT_STATES = {
    "RUNNING",
    "WORKING_TOOL",
    "WAITING_INPUT",
    "QUIET",
    "STALLED",
    "ORPHAN",
    "CORRUPT",
}


def terminal_endings(task):
    """lane -> epoch of the last observed transition into a terminal state.
    Fallback 'ended' source for lanes nobody finalized (a DIED lane has no
    wrapper left to write slot['ended'])."""
    out = {}
    try:
        with open(os.path.join(task_dir(task), "events.jsonl")) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("event") == "lane" and e.get("to") in TERMINAL_STATES:
                    try:
                        out[e.get("lane")] = datetime.datetime.fromisoformat(
                            e["ts"]
                        ).timestamp()
                    except (KeyError, ValueError, TypeError):
                        continue
    except OSError:
        pass
    return out


@contextlib.contextmanager
def file_lock(path):
    """Cross-platform exclusive lock on a sibling lock file (not the file
    being written — avoids append-mode byte-range lock quirks on Windows)."""
    f = open(path, "a+")
    try:
        if os.name == "nt":
            import msvcrt
            f.seek(0)
            msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        else:
            import fcntl
            fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        try:
            if os.name == "nt":
                import msvcrt
                f.seek(0)
                msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)
            else:
                import fcntl
                fcntl.flock(f, fcntl.LOCK_UN)
        finally:
            f.close()


def append_event(task, event):
    """Append one line to events.jsonl under an exclusive lock, serialized
    against every other writer (agent-dispatch dispatch/exit, this daemon's
    own watcher, and CLI `switchboard wait`). Rotates to events.jsonl.1
    (single rollover kept) once the file crosses EVENTS_MAX_BYTES."""
    event = dict(event, ts=iso())
    tdir = task_dir(task)
    os.makedirs(tdir, exist_ok=True)
    path = os.path.join(tdir, "events.jsonl")
    with file_lock(path + ".lock"):
        try:
            if os.path.getsize(path) >= EVENTS_MAX_BYTES:
                os.replace(path, path + ".1")
        except OSError:
            pass
        with open(path, "a") as f:
            f.write(json.dumps(event) + "\n")
            f.flush()
    return event


def tail_lines(path, n):
    """Last n lines of a file without loading it whole (F1/F8): read
    backwards in chunks until n+1 newlines are seen or the file start."""
    if n <= 0:
        return []
    try:
        f = open(path, "rb")
    except OSError:
        return []
    with f:
        f.seek(0, os.SEEK_END)
        pos = f.tell()
        block = 65536
        data = b""
        while pos > 0 and data.count(b"\n") <= n:
            read_size = min(block, pos)
            pos -= read_size
            f.seek(pos)
            data = f.read(read_size) + data
        lines = data.split(b"\n")
        if lines and lines[-1] == b"":
            lines.pop()
        if pos > 0:
            lines = lines[1:]  # first entry may be a partial line
        return [l.decode("utf-8", "replace") for l in lines[-n:]]


def tail_events(task, n):
    """Last n parsed events for a task, tailing the live file and, if it
    doesn't have enough lines yet (just rotated), the previous rollover."""
    tdir = task_dir(task)
    lines = tail_lines(os.path.join(tdir, "events.jsonl"), n)
    if len(lines) < n:
        more = tail_lines(os.path.join(tdir, "events.jsonl.1"), n - len(lines))
        lines = more + lines
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except Exception:
            pass
    return out


def list_tasks():
    if not os.path.isdir(ROOT):
        return []
    return sorted(d for d in os.listdir(ROOT) if os.path.isdir(os.path.join(ROOT, d)))


def task_status(task, quiet_after=DEFAULT_QUIET_AFTER, snap=None, stall_after=None):
    if snap is None:
        snap = ps_snapshot()
    rows = []
    endings = None  # events.jsonl read lazily, only if a terminal lane needs it
    for lane, slot in sorted(load_slots(task).items()):
        state, age = derive(slot, quiet_after, snap, stall_after=stall_after)
        ended = slot.get("ended")
        if ended is None and state in TERMINAL_STATES:
            if endings is None:
                endings = terminal_endings(task)
            ended = endings.get(lane) or slot.get("_mtime")
        # Serving-layer filter only: slot files and events.jsonl stay complete.
        expire = _done_expire()
        if (
            state in TERMINAL_STATES
            and ended is not None
            and expire > 0
            and (time.time() - ended) >= expire
        ):
            continue
        hb = {} if slot.get("corrupt") or slot.get("status") == "exited" else heartbeat(slot)
        rows.append(
            {
                "lane": lane,
                "state": state,
                "pid": slot.get("pid"),
                "wrapper_pid": slot.get("wrapper_pid"),
                "started": iso(slot.get("started", 0)) if not slot.get("corrupt") else None,
                "age_s": round(time.time() - slot.get("started", time.time())),
                "activity_s": round(age) if age is not None else None,
                "exit_code": slot.get("exit_code"),
                "ended_s": round(time.time() - ended) if ended is not None else None,
                "channel": slot.get("channel"),
                "report": slot.get("report"),
                "last_event": hb.get("event"),
                "phase": hb.get("phase"),
                "last_tool": hb.get("tool"),
            }
        )
    return {"task": task, "slots": rows}


# ---------------------------------------------------------------- CLI: status


def fmt_age(secs):
    if secs is None:
        return "-"
    if secs < 90:
        return f"{secs:.0f}s"
    if secs < 5400:
        return f"{secs / 60:.0f}m"
    return f"{secs / 3600:.1f}h"


def print_status(task, quiet_after, snap=None, stall_after=None):
    st = task_status(task, quiet_after, snap, stall_after=stall_after)
    print(f"TASK {task}  ({task_dir(task)})")
    if not st["slots"]:
        print("  (no slots)")
        return
    print(
        f"  {'LANE':22} {'STATE':14} {'PID':>7} {'UP':>6} {'ACTIVITY':>9} {'EXIT':>4}  CHANNEL"
    )
    for r in st["slots"]:
        act = fmt_age(r["activity_s"]) + " ago" if r["activity_s"] is not None else "-"
        ec = "-" if r["exit_code"] is None else str(r["exit_code"])
        print(
            f"  {r['lane']:22} {r['state']:14} {str(r['pid'] or '-'):>7} "
            f"{fmt_age(r['age_s']):>6} {act:>9} {ec:>4}  {r['channel'] or '-'}"
        )


def _maybe_ensure(args):
    """Opt-in soft ensure (--ensure flag or AGENT_SWITCHBOARD_ENSURE=1 env) so the
    HTTP/viewer tier is warmed back up after an idle park. Best-effort and
    silent: these CLI commands read state from disk directly and must keep
    working even if the daemon never comes up."""
    if getattr(args, "ensure", False) or os.environ.get("AGENT_SWITCHBOARD_ENSURE") == "1":
        try:
            ensure_daemon()
        except Exception:
            pass


def cmd_status(args):
    _maybe_ensure(args)
    tasks = [args.task] if args.task else list_tasks()
    if not tasks:
        print("no tasks registered")
        return 0
    snap = ps_snapshot()
    if args.json:
        print(json.dumps([task_status(t, args.quiet_after, snap,
                                       stall_after=getattr(args, "stall_after", None))
                          for t in tasks], indent=2))
    else:
        for t in tasks:
            print_status(t, args.quiet_after, snap,
                         stall_after=getattr(args, "stall_after", None))
    return 0


# ---------------------------------------------------------------- CLI: wait


def file_sig(path):
    try:
        st = os.stat(path)
        return (st.st_mtime, st.st_size)
    except FileNotFoundError:
        return None


def _refuse_keys(task):
    """Set of (ts, lane, reason) refuse events currently in the log."""
    out = set()
    for e in tail_events(task, 80):
        if e.get("event") == "refuse":
            out.add((e.get("ts"), e.get("lane"), e.get("reason")))
    return out


def write_json_atomic(path, obj):
    tmp = "%s.tmp%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=2)
    os.replace(tmp, path)


def write_advise(task, payload, extra_path=None):
    tdir = task_dir(task)
    os.makedirs(tdir, exist_ok=True)
    write_json_atomic(os.path.join(tdir, "advise.json"), payload)
    if extra_path:
        try:
            dest_dir = os.path.dirname(extra_path)
            if dest_dir:
                os.makedirs(dest_dir, exist_ok=True)
            write_json_atomic(extra_path, payload)
        except OSError:
            pass
    return payload


def _tree_orphan_lanes(task, rows, snap):
    """Active lanes whose recorded launcher pid is gone (supervisor vanished)."""
    by_lane = {r["lane"]: r for r in rows}
    out = []
    for lane, slot in load_slots(task).items():
        row = by_lane.get(lane)
        if not row or row["state"] not in ACTIVE_SLOT_STATES:
            continue
        lp = slot.get("launcher_cli_pid")
        if not lp:
            continue
        if snap is not None and not proc_alive(lp, None, snap):
            out.append(lane)
    return out


def build_advise(task, events, wait_exit, quiet_after=DEFAULT_QUIET_AFTER, snap=None):
    """Closed-verb advice object a master must read on every wake."""
    if snap is None:
        snap = ps_snapshot()
    st = task_status(task, quiet_after, snap)
    rows = st.get("slots") or []
    counts = {
        "running": 0,
        "working_tool": 0,
        "waiting_input": 0,
        "quiet": 0,
        "stalled": 0,
        "orphan": 0,
        "died": 0,
        "failed": 0,
        "done": 0,
        "corrupt": 0,
    }
    key_map = {
        "RUNNING": "running",
        "WORKING_TOOL": "working_tool",
        "WAITING_INPUT": "waiting_input",
        "QUIET": "quiet",
        "STALLED": "stalled",
        "ORPHAN": "orphan",
        "DIED": "died",
        "FAILED": "failed",
        "DONE": "done",
        "CORRUPT": "corrupt",
    }
    active = []
    for r in rows:
        k = key_map.get(r["state"])
        if k:
            counts[k] += 1
        if r["state"] in ACTIVE_SLOT_STATES:
            active.append(r["lane"])

    next_verbs = []
    newly = []
    refused = []
    for e in events or []:
        if e.get("event") == "lane":
            to = e.get("to")
            lane = e.get("lane")
            newly.append({"lane": lane, "state": to})
            if to == "DONE":
                next_verbs.append("review_done:%s" % lane)
            elif to == "FAILED":
                next_verbs.append("review_done:%s" % lane)
            elif to == "DIED":
                next_verbs.append("investigate_died:%s" % lane)
            elif to == "ORPHAN":
                next_verbs.append("investigate_orphan:%s" % lane)
            elif to == "STALLED":
                next_verbs.append("inspect_stalled:%s" % lane)
            elif to == "WAITING_INPUT":
                next_verbs.append("waiting_input:%s" % lane)
            elif to == "CORRUPT":
                next_verbs.append("escalate_corrupt:%s" % lane)
        elif e.get("event") == "refuse":
            refused.append(e)
            next_verbs.append("retry_refuse:%s" % (e.get("lane") or "?"))
        elif e.get("event") == "file":
            next_verbs.append("rescan")

    if wait_exit == 3 and not next_verbs:
        next_verbs.append("rescan")

    severity = "timeout" if wait_exit == 3 else "action"
    if any((e.get("to") if e.get("event") == "lane" else None) in
           ("ORPHAN", "STALLED", "WAITING_INPUT") for e in (events or [])):
        if wait_exit != 3:
            severity = "inspect"
    if any((e.get("to") if e.get("event") == "lane" else None) in
           ("DONE", "FAILED", "DIED", "CORRUPT") for e in (events or [])):
        severity = "action"
    if refused:
        severity = "action"

    payload = {
        "v": 1,
        "ts": iso(),
        "task": task,
        "severity": severity,
        "reason": ((events or [{}])[0].get("event") if events else "none"),
        "wait_exit": wait_exit,
        "events": events or [],
        "counts": counts,
        "active": active,
        "newly_terminal": [n for n in newly if n.get("state") in ("DONE", "FAILED", "DIED")],
        "refused": refused,
        "stalls": [r["lane"] for r in rows if r["state"] == "STALLED"],
        "tree_orphans": _tree_orphan_lanes(task, rows, snap),
        "next": next_verbs,
        "do_not": [
            "treat this as abort",
            "re-dispatch an ACTIVE or ORPHAN lane",
            "end the exec-master turn",
        ],
        "all_terminal": not active,
    }
    return payload


def _emit_wait_result(args, events, wait_exit):
    extra = getattr(args, "advise", None)
    payload = build_advise(args.task, events, wait_exit, args.quiet_after)
    write_advise(args.task, payload, extra)
    as_json = getattr(args, "json", False)
    if as_json:
        print(json.dumps(payload, indent=2))
        return wait_exit
    for e in events or []:
        if e.get("event") == "lane":
            print("EVENT lane %s: %s -> %s" % (e.get("lane"), e.get("from"), e.get("to")))
        elif e.get("event") == "file":
            print("EVENT file changed: %s" % e.get("path"))
        elif e.get("event") == "refuse":
            print("EVENT refuse %s: %s" % (e.get("lane"), e.get("reason")))
    if wait_exit == 0 and not events:
        print("all watched lanes already terminal:")
    if wait_exit == 3:
        print("TIMEOUT after %ss, no event" % getattr(args, "timeout", "?"))
    print("SEVERITY %s  next=%s" % (
        payload["severity"],
        ",".join(payload["next"]) if payload["next"] else "-",
    ))
    print_status(args.task, args.quiet_after)
    return wait_exit


def cmd_wait(args):
    _maybe_ensure(args)
    lanes_filter = set(args.lane or [])
    stay = getattr(args, "stay", False)
    alerting = set(ALERTING)
    if args.alert_quiet:
        alerting.add("QUIET")

    def snapshot():
        snap = ps_snapshot()
        slots = load_slots(args.task)
        if lanes_filter:
            slots = {k: v for k, v in slots.items() if k in lanes_filter}
        return {k: derive(v, args.quiet_after, snap,
                           stall_after=getattr(args, "stall_after", None))[0]
                for k, v in slots.items()}

    base_states = snapshot()
    base_files = {p: file_sig(p) for p in (args.watch_file or [])}
    seen_refuse = _refuse_keys(args.task)

    # ORPHAN alerts on transition but does NOT count as settled here — its
    # worker is still alive, and early-returning on it would let a caller
    # spin no-op waits (audit residual #1).
    settled = {"DONE", "FAILED", "DIED"}
    live = [l for l, s in base_states.items() if s not in settled]
    if base_states and not live and not base_files and not stay:
        return _emit_wait_result(args, [], 0)
    # Already-STALLED / WAITING_INPUT / CORRUPT at start is itself the
    # signal — do not sit the full timeout waiting for a transition that
    # will not come. ORPHAN stays blocking (T16): the worker is still alive.
    already = [
        (l, s) for l, s in base_states.items()
        if s in ("STALLED", "WAITING_INPUT", "CORRUPT")
    ]
    if already and not stay:
        evs = [{"event": "lane", "lane": l, "from": s, "to": s} for l, s in already]
        return _emit_wait_result(args, evs, 0)

    deadline = time.time() + args.timeout
    while time.time() < deadline:
        time.sleep(args.interval)
        events = []
        cur = snapshot()
        for lane, state in cur.items():
            old = base_states.get(lane)
            if state == old:
                continue
            if state in alerting:
                events.append({"event": "lane", "lane": lane, "from": old, "to": state})
            base_states[lane] = state
        for path, sig in list(base_files.items()):
            new = file_sig(path)
            if new != sig:
                events.append({"event": "file", "path": path})
                base_files[path] = new
        now_refuse = _refuse_keys(args.task)
        for key in now_refuse - seen_refuse:
            ts, lane, reason = key
            events.append({"event": "refuse", "lane": lane, "reason": reason, "ts": ts})
        seen_refuse = now_refuse
        if events:
            for e in events:
                if e.get("event") in ("lane", "file"):
                    append_event(args.task, e)
            return _emit_wait_result(args, events, 0)
    return _emit_wait_result(args, [], 3)


def cmd_advise(args):
    _maybe_ensure(args)
    extra = getattr(args, "advise", None)
    payload = build_advise(args.task, [], None, args.quiet_after)
    write_advise(args.task, payload, extra)
    print(json.dumps(payload, indent=2))
    return 0


def cmd_events(args):
    events = tail_events(args.task, args.n)
    if not events:
        print("(no events)")
        return 0
    for e in events:
        sys.stdout.write(json.dumps(e) + "\n")
    return 0


# ---------------------------------------------------------------- serve (daemon)

# Last busy-predicate result computed by the watcher tick (T6 /v1/health
# busy_reasons). Read-mostly from request threads; a single tick behind at
# worst — deliberately NOT recomputed per-request (would be a second sweep).
_BUSY_STATE = {"busy": None, "reasons": []}
_BUSY_STATE_LOCK = threading.Lock()


def _set_busy_state(busy, reasons):
    with _BUSY_STATE_LOCK:
        _BUSY_STATE["busy"] = busy
        _BUSY_STATE["reasons"] = list(reasons)


def get_busy_reasons():
    with _BUSY_STATE_LOCK:
        return list(_BUSY_STATE["reasons"])


class EventBus:
    def __init__(self, maxlen=BUS_MAXLEN):
        self.cond = threading.Condition()
        self.events = []
        self.seq = 0
        self.maxlen = maxlen
        # highest seq that has been trimmed out of `events`; a cursor at or
        # below this value can no longer be served — the caller missed a
        # gap of unknown size and must full-refresh instead.
        self.floor = 0
        # Set on graceful drain (SIGTERM/SIGINT/idle-exit) to wake every
        # blocked wait_for() immediately instead of leaving it to time out
        # on its own (a wait that cannot be woken is a lane failure).
        self.stopping = False

    def publish(self, task, event):
        with self.cond:
            self.seq += 1
            rec = dict(event, seq=self.seq, task=task)
            self.events.append(rec)
            if len(self.events) > self.maxlen:
                cut = len(self.events) - self.maxlen
                self.floor = self.events[cut - 1]["seq"]
                self.events = self.events[cut:]
            self.cond.notify_all()
            return rec

    def shutdown(self):
        with self.cond:
            self.stopping = True
            self.cond.notify_all()

    def wait_for(self, cursor, task=None, lanes=None, timeout=55.0):
        deadline = time.time() + timeout
        with self.cond:
            gap = cursor < self.floor
            while True:
                hits = [
                    e
                    for e in self.events
                    if e["seq"] > cursor
                    and (task is None or e["task"] == task)
                    and (not lanes or e.get("lane") in lanes or e["event"] == "file")
                ]
                if hits or gap or self.stopping:
                    return self.seq, hits, gap
                remaining = deadline - time.time()
                if remaining <= 0:
                    return self.seq, [], False
                self.cond.wait(min(remaining, 1.0))


def archived_terminal_state(tdir, lane, run_id):
    """Best-effort: find the history archive agent-dispatch wrote for run_id
    and derive its terminal state. Lets a same-tick DONE/FAILED -> re-dispatch
    (RUNNING -> terminal -> RUNNING collapsed between two watcher ticks)
    still surface the missed terminal leg instead of looking like nothing
    happened)."""
    if not run_id:
        return None
    run_id8 = run_id[:8]
    matches = sorted(glob.glob(os.path.join(tdir, "history", f"{lane}-*-{run_id8}.json")))
    if not matches:
        return None
    slot = read_json(matches[-1])
    if slot is None or slot.get("status") != "exited":
        return None
    return "DONE" if slot.get("exit_code") == 0 else "FAILED"


def cold_archive(tdir, lane, slot):
    """Move a long-finished slot out of the hot task dir into history/ so
    load_slots() (status + watcher) stops reloading it every tick (F2).
    15-min served-board omit of terminal rows is a publish filter in
    task_status (DONE_EXPIRE); it is not this 24h file-move. COLD_AFTER
    defaults to 86400s."""
    os.makedirs(os.path.join(tdir, "history"), exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    run_id8 = (slot.get("run_id") or "cold")[:8]
    dest = os.path.join(tdir, "history", f"{lane}-{stamp}-{run_id8}.json")
    src = os.path.join(tdir, f"slot-{lane}.json")
    try:
        os.replace(src, dest)
        return True
    except OSError:
        return False


def watcher_loop(bus, quiet_after, stop_evt, tick=1.0, idle_cb=None):
    """Per-tick: one ps sweep drives BOTH lane-state derivation (existing
    lane-state derivation below) AND the idle busy predicate — never a second
    ps sweep for idle detection."""
    last = {}  # (task, lane) -> (state, run_id)
    seen_refuse = {}  # task -> set of refuse keys
    idle_since = None
    idle_samples = 0
    while not stop_evt.is_set():
        rich_snap = ps_cli_snapshot()  # the ONE ps sweep for this tick
        snap = (
            {pid: rec["command"] for pid, rec in rich_snap.items()}
            if rich_snap is not None
            else None
        )
        seen = set()
        any_active = False
        for task in list_tasks():
            tdir = task_dir(task)
            for lane, slot in load_slots(task).items():
                state, _ = derive(slot, quiet_after, snap)
                if state in ACTIVE_SLOT_STATES:
                    any_active = True
                run_id = slot.get("run_id")
                key = (task, lane)
                old_state, old_run_id = last.get(key, (None, None))

                if old_state is None:
                    # First sight of this lane: publish an appear event so a
                    # long-polling client learns about it immediately instead
                    # of waiting for the next 30s status tick.
                    ev = {"event": "lane", "lane": lane, "from": None, "to": state}
                    append_event(task, ev)
                    bus.publish(task, ev)
                elif old_run_id and run_id and run_id != old_run_id:
                    # Re-dispatched inside one tick window: the derived state
                    # string can match on both sides (e.g. RUNNING == RUNNING)
                    # even though a whole DONE/FAILED and restart happened in
                    # between. Recover the missed terminal leg and publish
                    # both transitions.
                    mid = archived_terminal_state(tdir, lane, old_run_id) or old_state
                    if mid != old_state:
                        ev = {"event": "lane", "lane": lane, "from": old_state, "to": mid}
                        append_event(task, ev)
                        bus.publish(task, ev)
                    if state != mid:
                        ev = {"event": "lane", "lane": lane, "from": mid, "to": state}
                        append_event(task, ev)
                        bus.publish(task, ev)
                elif old_state != state:
                    ev = {"event": "lane", "lane": lane, "from": old_state, "to": state}
                    append_event(task, ev)
                    bus.publish(task, ev)
                    try:
                        write_advise(
                            task,
                            build_advise(task, [ev], 0, quiet_after, snap),
                        )
                    except Exception:
                        pass

                if state in TERMINAL_STATES:
                    ended = slot.get("ended") or slot.get("_mtime")
                    if ended is not None and (time.time() - ended) >= COLD_AFTER:
                        if cold_archive(tdir, lane, slot):
                            last.pop(key, None)
                            continue  # archived: drop from `last`, not `seen`

                seen.add(key)
                last[key] = (state, run_id)

            # Surface capacity/same-lane refuse so waiters wake.
            now_ref = _refuse_keys(task)
            prev_ref = seen_refuse.get(task, set())
            for key_r in now_ref - prev_ref:
                ts, lane_r, reason = key_r
                ev = {"event": "refuse", "lane": lane_r, "reason": reason, "ts": ts}
                bus.publish(task, ev)
            seen_refuse[task] = now_ref

        for stale in list(last.keys() - seen):
            del last[stale]

        # ---- Idle busy predicate: cli_busy() OR viewer_running() OR
        # any_active (computed above from this SAME tick's slot pass) ----
        # FAIL CLOSED: rich_snap is None (ps sweep failed) OR empty mapping
        # (total parse failure on a live Mac — never a real idle machine)
        # -> busy. Empty is NOT "no processes"; ps -ax always yields rows.
        if rich_snap is None or not rich_snap:
            busy, reasons = True, ["ps_unavailable"]
        else:
            reasons = []
            if not IDLE_TEST_FORCE_NOT_BUSY:
                if cli_busy(rich_snap):
                    reasons.append("cli")
                if viewer_running(rich_snap):
                    reasons.append("viewer")
            if any_active:
                reasons.append("slots")
            busy = bool(reasons)
        _set_busy_state(busy, reasons)

        if idle_cb is not None and not IDLE_DISABLE:
            if busy:
                idle_since = None
                idle_samples = 0
            else:
                idle_samples += 1
                if idle_since is None:
                    idle_since = time.time()
                elapsed = time.time() - idle_since
                # Require N consecutive idle ticks AND the full grace window
                # elapsed — never arm on one lucky reading.
                if idle_samples >= IDLE_MIN_SAMPLES and elapsed >= IDLE_GRACE:
                    idle_cb(f"idle {elapsed:.0f}s (no cli/viewer/active-slot)")
                    return  # drain_and_exit is taking over; stop ticking

        stop_evt.wait(tick)


def _health_ok(host, port, timeout=0.3):
    """Short-timeout GET /v1/health probe. True only on a well-formed
    {"ok": true} response — never raises."""
    try:
        with urllib.request.urlopen(
            f"http://{host}:{port}/v1/health", timeout=timeout
        ) as resp:
            body = json.loads(resp.read().decode())
            return bool(body.get("ok"))
    except Exception:
        return False


def ensure_daemon(host=None, port=None, timeout=5.0):
    """Health probe; on fail, `launchctl kickstart gui/$(id -u)/LABEL`
    (never -k — never bounce a healthy peer), then poll; if the
    job is missing/unloaded or this isn't macOS, fall back to a direct
    background spawn. Best-effort: never raises, never blocks a caller
    that doesn't want to wait (see cmd_status/cmd_wait --ensure and
    agent-dispatch's fire-and-forget call).

    AGENT_SWITCHBOARD_ENSURE_DISABLE=1 makes this a pure no-op (test isolation —
    the daemon must never call real `launchctl kickstart` against the
    live com.agent-switchboard job from an automated test run).
    AGENT_SWITCHBOARD_ENSURE_NO_KICKSTART=1 skips only the launchctl subprocess
    call (still probes + falls back to direct spawn) — used by tests that
    want to exercise the fallback path without touching launchctl.
    """
    if ENSURE_DISABLE:
        return False
    host = host or os.environ.get("AGENT_SWITCHBOARD_HOST", "127.0.0.1")
    port = port or int(os.environ.get("AGENT_SWITCHBOARD_PORT", DEFAULT_PORT))

    if _health_ok(host, port):
        return True

    if not ENSURE_NO_KICKSTART and sys.platform == "darwin":
        try:
            subprocess.run(
                ["launchctl", "kickstart", f"gui/{os.getuid()}/{LAUNCHD_LABEL}"],
                capture_output=True,
                timeout=5,
            )
        except Exception:
            pass
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if _health_ok(host, port):
                return True
            time.sleep(0.5)

    if _health_ok(host, port):
        return True

    # Job missing / kickstart unavailable / non-macOS: direct-spawn fallback.
    try:
        sb_path = os.path.abspath(__file__)
        subprocess.Popen(
            [sys.executable, sb_path, "serve", "--host", host, "--port", str(port)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        return False

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if _health_ok(host, port):
            return True
        time.sleep(0.5)
    return False


def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    os.makedirs(ROOT, exist_ok=True)

    # Bind FIRST — the port is the real mutex; the lock file is advisory
    # metadata for humans and tools (audit #10).
    try:
        srv_holder = {}
        bus = EventBus()
        wait_sem = threading.Semaphore(WAIT_CAP)
        t0 = time.time()
        # Fresh per serve start: lets clients tell "same daemon, cursor still
        # valid" from "daemon restarted, in-RAM bus/seq reset — resync".
        boot_id = uuid.uuid4().hex

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def _json(self, obj, code=200, headers=None):
                body = json.dumps(obj).encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Access-Control-Allow-Origin", "*")
                for k, v in (headers or {}).items():
                    self.send_header(k, v)
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                u = urllib.parse.urlparse(self.path)
                q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
                if u.path == "/v1/health":
                    self._json(
                        {
                            "ok": True,
                            "version": VERSION,
                            "uptime_s": round(time.time() - t0),
                            "root": ROOT,
                            "cursor": bus.seq,
                            "boot_id": boot_id,
                            "busy_reasons": get_busy_reasons(),
                        }
                    )
                elif u.path == "/v1/tasks":
                    self._json(list_tasks())
                elif u.path == "/v1/status":
                    # Board expiry (DONE_EXPIRE) lives in task_status.
                    tasks = [q["task"]] if q.get("task") else list_tasks()
                    snap = ps_snapshot()
                    self._json([task_status(t, args.quiet_after, snap) for t in tasks])
                elif u.path == "/v1/events":
                    task = q.get("task")
                    if not task or not name_ok(task):
                        return self._json({"error": "valid task required"}, 400)
                    n = int(q.get("n", 50))
                    self._json(tail_events(task, n))
                elif u.path == "/v1/cli":
                    # Forest of CLI instances. 5s TTL; one ps per miss.
                    self._json(get_cli_payload(boot_id=boot_id))
                elif u.path == "/v1/advise":
                    task = q.get("task")
                    if not task or not name_ok(task):
                        return self._json({"error": "valid task required"}, 400)
                    snap = ps_snapshot()
                    self._json(build_advise(task, [], None, args.quiet_after, snap))
                elif u.path == "/v1/wait":
                    # Concurrency cap: the jetsam thread
                    # limit is 32; a pile of long-polls must fail loud with
                    # a retryable 503 instead of starving every other route.
                    if not wait_sem.acquire(blocking=False):
                        return self._json(
                            {"error": "wait_capacity"}, 503, {"Retry-After": "5"}
                        )
                    try:
                        cursor = int(q.get("cursor", 0))
                        lanes = set(q["lanes"].split(",")) if q.get("lanes") else None
                        timeout = min(float(q.get("timeout", 55)), 120.0)
                        seq, hits, gap = bus.wait_for(cursor, q.get("task"), lanes, timeout)
                        resp = {"cursor": seq, "events": hits, "boot_id": boot_id}
                        if gap:
                            resp["gap"] = True
                        self._json(resp)
                    finally:
                        wait_sem.release()
                else:
                    self._json({"error": "not found"}, 404)

        srv = ThreadingHTTPServer((args.host, args.port), Handler)
        # Request threads must never block process exit, and server_close()
        # must never attempt an unbounded join on them — we wake every
        # blocked /v1/wait explicitly on drain (bus.shutdown()) and rely on
        # these two flags as the bound-of-last-resort ("a wait
        # that cannot be woken is a lane failure").
        srv.daemon_threads = True
        srv.block_on_close = False
        srv_holder["srv"] = srv
    except OSError as e:
        # Duplicate instance: probe the peer before deciding this is
        # a crash. Healthy peer -> exit 0 (nothing to restart);
        # dead socket -> exit 1 with an actionable message (never exit 2
        # here — that would thrash under KeepAlive.SuccessfulExit=false).
        peer_healthy = _health_ok(args.host, args.port, timeout=2.0)
        if peer_healthy:
            print(
                f"switchboard serve: {args.host}:{args.port} already served by a "
                f"healthy peer ({e}) — exiting 0", file=sys.stderr
            )
            return 0
        print(
            f"switchboard serve: cannot bind {args.host}:{args.port} ({e}) and no "
            f"healthy peer answered /v1/health — the port is held by something "
            f"else. Check `lsof -iTCP:{args.port} -sTCP:LISTEN`, free the port, or "
            f"pick a different --port.", file=sys.stderr
        )
        return 1

    lock_path = os.path.join(ROOT, "serve.lock")
    with open(lock_path, "w") as f:
        json.dump({"pid": os.getpid(), "port": args.port, "started": iso()}, f)

    stop_evt = threading.Event()
    shutdown_state = {"done": False}
    shutdown_lock = threading.Lock()

    def drain_and_exit(code, reason):
        """Graceful drain: stop accepting, wake every pending
        /v1/wait, join the watcher with a bound, remove the lock, exit.
        Idempotent — signal + idle-exit could theoretically race."""
        with shutdown_lock:
            if shutdown_state["done"]:
                return
            shutdown_state["done"] = True
        sys.stderr.write(f"switchboard serve: {reason} — draining, exit {code}\n")
        sys.stderr.flush()
        stop_evt.set()
        bus.shutdown()  # wake every blocked wait_for() immediately
        try:
            srv.shutdown()  # unblocks serve_forever() on the main thread
        except Exception:
            pass
        try:
            srv.server_close()
        except Exception:
            pass
        watcher_thread.join(timeout=3)  # bounded — never hang the exit path
        try:
            os.remove(lock_path)
        except FileNotFoundError:
            pass
        os._exit(code)

    def async_drain_and_exit(code, reason):
        # Always off-thread: srv.shutdown() must be called from a thread
        # OTHER than the one running serve_forever(), or it deadlocks —
        # and a signal handler runs ON the main thread that IS running it.
        threading.Thread(target=drain_and_exit, args=(code, reason), daemon=True).start()

    def handle_signal(signum, _frame):
        async_drain_and_exit(0, f"signal {signum} received")

    for sig_name in ("SIGTERM", "SIGINT"):
        if hasattr(signal, sig_name):
            try:
                signal.signal(getattr(signal, sig_name), handle_signal)
            except (ValueError, OSError):
                pass

    watcher_thread = threading.Thread(
        target=watcher_loop,
        args=(bus, args.quiet_after, stop_evt),
        kwargs={"idle_cb": lambda reason: async_drain_and_exit(0, reason)},
        daemon=True,
    )
    watcher_thread.start()

    print(f"switchboard serve v{VERSION} on http://{args.host}:{args.port}  root={ROOT}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        async_drain_and_exit(0, "KeyboardInterrupt")
    # serve_forever() only returns once srv.shutdown() has been called, which
    # only ever happens inside drain_and_exit() on another thread — that
    # thread always finishes with os._exit(), so this is a defensive
    # fallback only (e.g. drain_and_exit hasn't reached os._exit() yet).
    return 0


# ---------------------------------------------------------------- entry


def main():
    ap = argparse.ArgumentParser(
        description="Slot registry, event waits, and status service for agent lanes (observe-only)."
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("status", help="derived state of every slot")
    p.add_argument("--task")
    p.add_argument("--json", action="store_true")
    p.add_argument("--quiet-after", type=float, default=DEFAULT_QUIET_AFTER)
    p.add_argument("--stall-after", type=float, default=None,
                   help="headless silence budget (default: AGENT_SWITCHBOARD_STALL_AFTER or 90)")
    p.add_argument("--ensure", action="store_true",
                   help="best-effort ensure_daemon() before running (or set AGENT_SWITCHBOARD_ENSURE=1)")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser(
        "wait", help="block until a lane/file event (exit 0) or timeout (exit 3)"
    )
    p.add_argument("--task", required=True)
    p.add_argument("--timeout", type=float, default=570)
    p.add_argument("--interval", type=float, default=2)
    p.add_argument("--lane", action="append")
    p.add_argument("--watch-file", action="append")
    p.add_argument("--alert-quiet", action="store_true",
                   help="also return on RUNNING->QUIET transitions")
    p.add_argument("--quiet-after", type=float, default=DEFAULT_QUIET_AFTER)
    p.add_argument("--stall-after", type=float, default=None)
    p.add_argument("--json", action="store_true",
                   help="print the advise payload instead of human status")
    p.add_argument("--stay", action="store_true",
                   help="do not early-return if currently idle (orchestrator safety-net)")
    p.add_argument("--advise",
                   help="also write the advise payload to this path")
    p.add_argument("--ensure", action="store_true",
                   help="best-effort ensure_daemon() before running (or set AGENT_SWITCHBOARD_ENSURE=1)")
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("advise", help="print the current advise payload for a task")
    p.add_argument("--task", required=True)
    p.add_argument("--quiet-after", type=float, default=DEFAULT_QUIET_AFTER)
    p.add_argument("--advise", help="also write the payload to this path")
    p.add_argument("--ensure", action="store_true")
    p.set_defaults(fn=cmd_advise)

    p = sub.add_parser("events", help="tail the observation log")
    p.add_argument("--task", required=True)
    p.add_argument("-n", type=int, default=20)
    p.set_defaults(fn=cmd_events)

    p = sub.add_parser("serve", help="background HTTP status service (long-poll)")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", type=int, default=DEFAULT_PORT)
    p.add_argument("--quiet-after", type=float, default=DEFAULT_QUIET_AFTER)
    p.set_defaults(fn=cmd_serve)

    args = ap.parse_args()
    if getattr(args, "task", None) is not None and not name_ok(args.task):
        print(f"switchboard: bad task name {args.task!r} (alnum, dash, underscore, dot)",
              file=sys.stderr)
        return 2
    for lane in getattr(args, "lane", None) or []:
        if not name_ok(lane):
            print(f"switchboard: bad lane name {lane!r}", file=sys.stderr)
            return 2
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
