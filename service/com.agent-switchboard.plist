<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-switchboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/PATH/TO/REPO/bin/switchboard</string>
        <string>serve</string>
        <string>--port</string>
        <string>17920</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- Restart only on an UNSUCCESSFUL exit (crash / nonzero). A clean
             exit 0 — idle shutdown or a healthy-duplicate-peer bind-fail —
             is intentional and must stick. Boolean KeepAlive=true would
             resurrect idle-exit immediately. -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/agent-switchboard.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agent-switchboard.log</string>
</dict>
</plist>
